# Required: your Anthropic API key (add it in Vercel → Settings → Environment Variables)
ANTHROPIC_API_KEY=

# Required: Postgres connection string. Added automatically when you connect Neon in Vercel → Storage.
# For local testing without a real database you can use: DATABASE_URL=pglite:memory
DATABASE_URL=

# Required: password for the /admin page, where you create school codes.
ADMIN_PASSWORD=

# Optional: model to use (defaults to claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Optional: MOCK_AI=1 returns sample answers without calling the AI (local testing only).
MOCK_AI=
